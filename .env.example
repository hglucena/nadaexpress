# Chave da API do Gemini, lida só pelas funções em /api.
# Pega em https://aistudio.google.com/apikey (é separado da assinatura Gemini Pro do app).
# NUNCA prefixar com VITE_ — qualquer variável VITE_ vai parar no bundle do cliente.
GEMINI_API_KEY=

# Chave da API do DeepSeek, usada pelo vendedor-agente (/api/vendedor).
# Pega em https://platform.deepseek.com/
DEEPSEEK_API_KEY=
